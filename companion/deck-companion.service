[Unit]
Description=Deck Shell Local Companion
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/share/deck-shell/companion/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
WorkingDirectory=%h/.local/share/deck-shell/companion
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

[Unit]
Description=Deck Shell Steam Auth Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deck-backend
WorkingDirectory=/opt/deck-shell-backend
EnvironmentFile=/etc/deck-shell-backend/env
ExecStart=/opt/deck-shell-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deck-shell-backend

[Install]
WantedBy=multi-user.target

# Copy this file to backend\.env and fill in your values.
# NEVER commit .env to git.

# Session signing key — generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
DECK_SECRET=change_me_to_a_long_random_string

# Your Steam Web API key — get one free at:
#   https://steamcommunity.com/dev/apikey
#   Use http://api.accesshomeserver.uk as the domain when registering.
STEAM_API_KEY=your_steam_api_key_here

# Public URL of this backend — used in OpenID return_to.
# This must match the subdomain you published in your Cloudflare tunnel.
BACKEND_URL=https://api.accesshomeserver.uk

# STEAM_DIR has been removed.
# Installed-game detection now happens on each user's Arch machine
# by the QML shell reading local appmanifest_*.acf files — not on this server.

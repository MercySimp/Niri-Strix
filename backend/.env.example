# Copy to .env and fill in values before running the backend

# Your Steam Web API key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# The public HTTPS hostname this service is reachable at
# Must match openid.realm and openid.return_to
# e.g. https://auth.deckos.example.com
BACKEND_HOST=https://auth.deckos.example.com

# Random secret for signing sessions – generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_32_char_string
